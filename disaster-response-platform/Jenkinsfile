pipeline {
    agent any

    environment {
        DOCKER_CREDENTIALS = credentials('docker-hub-credentials')
        KUBECONFIG_ID = 'k8s-config'
        SLACK_TOKEN = credentials('slack-token')
        DOCKER_IMAGE_BACKEND = 'disaster-response-backend'
        DOCKER_IMAGE_FRONTEND = 'disaster-response-frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Lint') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            sh 'npm install'
                            // sh 'npm run lint'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm install'
                            // sh 'npm run lint'
                        }
                    }
                }
            }
        }

        stage('Test & SonarQube') {
            steps {
                // Mock test run
                echo "Running unit tests and SonarQube analysis..."
                // sh 'npm test'
                /*
                withSonarQubeEnv('SonarQube') {
                    sh 'sonar-scanner'
                }
                */
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE_BACKEND}:${env.BUILD_ID}", "./backend")
                    docker.build("${DOCKER_IMAGE_FRONTEND}:${env.BUILD_ID}", "./frontend")
                }
            }
        }

        stage('Push Images') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image("${DOCKER_IMAGE_BACKEND}:${env.BUILD_ID}").push()
                        docker.image("${DOCKER_IMAGE_FRONTEND}:${env.BUILD_ID}").push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: KUBECONFIG_ID]) {
                    sh "sed -i 's/latest/${env.BUILD_ID}/g' k8s/backend-deployment.yaml"
                    sh "sed -i 's/latest/${env.BUILD_ID}/g' k8s/frontend-deployment.yaml"
                    sh "kubectl apply -f k8s/"
                }
            }
        }
    }

    post {
        success {
            echo "Deployment Successful!"
            // slackSend channel: '#deployments', color: 'good', message: "Successful Deployment: ${env.JOB_NAME} ${env.BUILD_ID}"
        }
        failure {
            echo "Deployment Failed! Initiating Rollback..."
            withKubeConfig([credentialsId: KUBECONFIG_ID]) {
                sh "kubectl rollout undo deployment/backend-deployment"
                sh "kubectl rollout undo deployment/frontend-deployment"
            }
            // slackSend channel: '#deployments', color: 'danger', message: "Failed Deployment: ${env.JOB_NAME} ${env.BUILD_ID}"
        }
    }
}
